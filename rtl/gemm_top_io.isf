# Efinity Interface Configuration - M6 gemm_top, configuration A.
#
# Device: T8F49, 49-ball WLCSP
#
# Pin-for-pin identical to link_narrow_io.isf, and deliberately so: M2 measured
# 8.94 MB/s with zero errors on exactly these four wires, and M6 changes what is
# behind them, not which ones they are. Any difference between this file and
# link_narrow_io.isf would make the M2 measurement inapplicable, so there is
# none. Configuration C touches the .v and this file together, and it now
# exists: gemm_top_wide.v / gemm_top_wide_io.isf, measured in M7f/M7g at
# 16.791 MB in 643 ms of wire, 36.5 ns/B, bit-exact. This file stays
# configuration A, which the board still runs first on every boot so that the
# two are compared in one session rather than across two.
#
# Every wire here survives FPGA configuration - none of the 0.1" header GPIO is
# consumed - which is what leaves GPIO 8/9/12/13 free for the camera in M7b.
#
# link_clk lands on F3 (GPIOL_02_CCK), which is NOT one of the T8F49's
# global-clock balls (B3, C3, E4, E6). Efinity routes it on general fabric. In
# M2 that carried ~11 flops; here it clocks the whole GEMM tile, so the
# clock-skew line in the timing report is the number to read first, not the
# Fmax line.

# Device setting
design.set_device_property("1A","VOLTAGE","3.3","IOBANK")
design.set_device_property("1B","VOLTAGE","3.3","IOBANK")
design.set_device_property("1C","VOLTAGE","1.1","IOBANK")
design.set_device_property("2A","VOLTAGE","3.3","IOBANK")
design.set_device_property("2B","VOLTAGE","3.3","IOBANK")

# Create instance
design.create_input_gpio("clk_32m")
design.create_input_gpio("link_clk")
design.create_input_gpio("link_mosi")
design.create_output_gpio("link_miso")
design.create_output_gpio("link_flag")
design.create_output_gpio("led_r_n")
design.create_output_gpio("led_g_n")
design.create_output_gpio("led_b_n")

# Set resource assignment
design.assign_pkg_pin("clk_32m","B4")     # Y2, gated by RP GPIO19 (OSC_EN)
design.assign_pkg_pin("link_clk","F3")    # CCK       <- RP GPIO2
design.assign_pkg_pin("link_mosi","F2")   # CDI0      <- RP GPIO3
design.assign_pkg_pin("link_miso","G3")   # SS_N      -> RP GPIO1
design.assign_pkg_pin("link_flag","A4")   # NSTATUS   -> RP GPIO6

# The vendor example has red and blue swapped. The schematic wires E1 = red and
# G1 = blue (D1 is common-anode, cathodes through R7/R8/R9); plasm_led_io.isf
# names them the other way round. These assignments follow the schematic, so the
# colour that lights is the colour in the signal name.
design.assign_pkg_pin("led_r_n","E1")     # CDI7
design.assign_pkg_pin("led_g_n","F1")     # CDI1
design.assign_pkg_pin("led_b_n","G1")     # CDI5
